# n8n Workflow Agent — Environment Variables

# LLM Provider: openai or anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# n8n Instance
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=

# Database (SQLite default, swap for PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./data/workflows.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/n8n_agent

# API Server
API_HOST=127.0.0.1
API_PORT=8000

# Security (change in production)
SECRET_KEY=change-me-in-production-super-secret-key

# Timezone
DEFAULT_TIMEZONE=UTC

# Debug
DEBUG=false
